# DAMA — production finance configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"
DEMO_MODE=false
REAL_MONEY_ENABLED=false

# Finance defaults
PLATFORM_FEE_PERCENT=5
DEFAULT_CURRENCY=USDT
NEXT_PUBLIC_APP_URL="https://YOUR-DOMAIN.com"

# Binance Pay Merchant API — keep these server-side only; NEVER expose them to NEXT_PUBLIC_*.
# Get the Certificate SN and API Secret Key from the Binance Pay Merchant Portal.
BINANCE_PAY_ENABLED=false
BINANCE_PAY_CERT_SN=""
BINANCE_PAY_SECRET_KEY=""
BINANCE_PAY_BASE_URL="https://bpay.binanceapi.com"
BINANCE_PAY_WEBHOOK_URL="https://YOUR-DOMAIN.com/api/payments/binance/webhook"
